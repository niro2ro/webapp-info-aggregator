# このファイルはコミットする（キー名のみ・値は入れない）。
# 実値は各自 .env にコピーして設定する（.env は .gitignore 済み・NFR-11 / DD-CFG-04）。
# コピー: cp .env.example .env

# --- DB（ローカルは docker-compose の既定値と揃える） ---
DB_URL=jdbc:postgresql://localhost:5432/aggregator
DB_USER=aggregator
DB_PASSWORD=aggregator

# --- 収集マナー（User-Agent に連絡先を明記・BD-IF-01-03） ---
APP_USER_AGENT=Aggregator/0.1 (contact: you@example.com)

# --- Claude API（Phase 2・任意）。既定 false のまま動作確認できる。使うときだけ true＋キー設定 ---
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5

# --- LINE Messaging API（Phase 4・任意）。既定 false のまま通知フローは NoOp で確認できる ---
LINE_ENABLED=false
LINE_CHANNEL_TOKEN=
