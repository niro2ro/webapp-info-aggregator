<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.aggregator</groupId>
        <artifactId>aggregator-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>aggregator-domain</artifactId>
    <name>aggregator-domain</name>
    <description>エンティティ・enum・値オブジェクト・ドメインルール（フレームワーク非依存を基本）</description>

    <dependencies>
        <!-- JPA アノテーション（@Entity/@Converter 等）だけを使う。実行時の Hibernate/Spring Data は
             infrastructure 側が持ち込む。ドメインは「永続化の注釈」までに留め、DB実装には依存しない。 -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>

        <!-- 単体テスト（JUnit 5 + AssertJ + Mockito）。バージョンは Spring Boot BOM 管理。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
