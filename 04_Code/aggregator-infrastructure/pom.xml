<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.aggregator</groupId>
        <artifactId>aggregator-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>aggregator-infrastructure</artifactId>
    <name>aggregator-infrastructure</name>
    <description>JPA/Hibernate・Flyway・外部API/収集アダプタ（ドメインのポート実装）</description>

    <dependencies>
        <dependency>
            <groupId>com.example.aggregator</groupId>
            <artifactId>aggregator-domain</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>

        <!-- Spring Data JPA + Hibernate（データアクセス設計書） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Flyway（SQL ベースのマイグレーション。V1__*.sql に DDL） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Flyway 10 は DB 種別ごとにモジュールが分かれる（PostgreSQL 用） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- PostgreSQL ドライバ -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- RSS/Atom 解析（FR-02-01）。Spring Boot BOM 管理外のためバージョン明示。 -->
        <dependency>
            <groupId>com.rometools</groupId>
            <artifactId>rome</artifactId>
            <version>2.1.0</version>
        </dependency>
        <!-- HTML 解析（専用パーサー・FR-02-02）。バージョンは Spring Boot BOM 管理。 -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.18.1</version>
        </dependency>

        <!-- Claude API（収集時の構造化のみ・FR-02-03）。公式 anthropic-java。
             BOM 管理外のためバージョン明示。実装着手時に Maven Central の最新を確認（CLAUDE.md §0-4）。 -->
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>2.53.0</version>
        </dependency>

        <!-- LINE Messaging API（通知・FR-03）。公式 line-bot-sdk-java の messaging クライアント。
             push のみ使用（webhook 受信は Phase 5 以降）。バージョンは着手時に公式確認。 -->
        <dependency>
            <groupId>com.linecorp.bot</groupId>
            <artifactId>line-bot-messaging-api-client</artifactId>
            <version>10.1.0</version>
        </dependency>

        <!-- BCrypt（管理者PINのハッシュ・SC-01/09）。フル Spring Security ではなく暗号ユーティリティのみを
             使う（Phase 5 は軽量認証。Phase 6 で本格認証へ差し替え）。バージョンは Spring Boot BOM 管理。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- robots.txt 解析（収集マナー・FR-02-05）。自前実装せず crawler-commons を使う（BD-IF-01-01）。 -->
        <dependency>
            <groupId>com.github.crawler-commons</groupId>
            <artifactId>crawler-commons</artifactId>
            <version>1.6</version>
        </dependency>

        <!-- リトライ（一時障害に指数バックオフ・BD-BATCH-C-04）。Resilience4j のプログラム API を局所利用。 -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-retry</artifactId>
            <version>2.4.0</version>
        </dependency>

        <!-- 単体テスト（JUnit 5 + Mockito + AssertJ）。バージョンは Spring Boot BOM 管理。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
