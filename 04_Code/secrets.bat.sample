@echo off
rem ============================================================
rem  このファイルを「secrets.bat」という名前でコピーして、
rem  実際のキーを入れてください（secrets.bat は git に載りません）。
rem  コピー方法（cmd）:  copy secrets.bat.sample secrets.bat
rem ============================================================

rem --- LLM（発売日の抽出）を使う場合 ---
set LLM_ENABLED=true
set ANTHROPIC_API_KEY=sk-ant-ここに実キー
rem set LLM_MODEL=claude-sonnet-5

rem --- LINE通知を使う場合（任意） ---
rem set LINE_ENABLED=true
rem set LINE_CHANNEL_TOKEN=ここにチャネルアクセストークン

rem --- DBの接続を既定から変える場合（通常は不要） ---
rem set DB_URL=jdbc:postgresql://localhost:5432/aggregator
rem set DB_USER=aggregator
rem set DB_PASSWORD=aggregator
