# ルートの .gitignore（リポジトリ全体の共通ルール）
# 実装モジュール固有の除外は 04_Code/.gitignore を参照。

# ===== 秘密情報（絶対にコミットしない・NFR-11）=====
.env
*.env
.env.*
!.env.example
secrets.bat
!secrets.bat.sample
*.pem
*.key
*.p12

# ===== ビルド成果物（Maven / Java）=====
target/
*.class
*.jar
!**/.mvn/wrapper/maven-wrapper.jar

# ===== フロントエンド生成物（Vaadin）=====
**/node_modules/
**/frontend/generated/

# ===== Docker（データボリューム。docker-compose.yml 自体は追跡する）=====
**/pgdata/
**/postgres-data/

# ===== ログ・ローカル取得のバイナリ =====
logs/
*.log
*.exe

# ===== IDE =====
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# ===== OS =====
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*~

# ===== Claude Code（PCローカル設定・同期しない）=====
.claude/settings.local.json
