<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot の BOM とプラグイン設定を継承する（依存バージョンを一元管理） -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.example.aggregator</groupId>
    <artifactId>aggregator-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>aggregator-parent</name>
    <description>テーマ別最新情報アグリゲーター（Maven マルチモジュール親POM）</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- モジュール分割は詳細設計 アーキテクチャ設計書 §1 に対応 -->
    <modules>
        <module>aggregator-domain</module>
        <module>aggregator-infrastructure</module>
        <module>aggregator-web</module>
        <module>aggregator-batch</module>
    </modules>
</project>
